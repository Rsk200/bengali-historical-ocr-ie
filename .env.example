# ==============================================================================
# Environment Configuration Template for Bengali Historical OCR & IE Project
# Copy this file to '.env' and fill in your actual credentials/paths.
# NOTE: Never commit your real '.env' file containing secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision-Language & LLM Extraction API Keys
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Required for GeminiOCR and Phase 5 LLMExtractionEngine)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if running GPT-4o / GPT-4o-mini vision or extraction)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Classical OCR Local Binaries & Language Models
# ------------------------------------------------------------------------------
# Windows executable path for Tesseract OCR (default UB-Mannheim installer location)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Directory containing 'ben.traineddata' and 'eng.traineddata'
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# ------------------------------------------------------------------------------
# 3. Cloud Document AI / Cloud Vision (Optional)
# ------------------------------------------------------------------------------
# Path to Google Cloud Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Cognitive Services / Document Intelligence (Optional)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
